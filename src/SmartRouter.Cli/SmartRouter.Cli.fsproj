<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SmartRouter</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      FS3511 — F# state machine fallback warning. The long task {} block in
      ChatCompletions.fs:172-396 cannot be inlined statically by the .NET 10
      F# compiler; a dynamic implementation is used instead. Functionally
      correct; only marginally slower than the inlined form. Suppressing
      because TreatWarningsAsErrors otherwise blocks Release builds (issue #1).
      Refactoring the handler to fit the inliner is tracked as a future
      improvement when the hot path is restructured.
    -->
    <NoWarn>$(NoWarn);3511</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Adapters (Infrastructure) — must precede Endpoints and Program -->
    <Compile Include="Adapters/Json.fs" />
    <Compile Include="Adapters/Logging.fs" />
    <Compile Include="Adapters/ColdStart.fs" />           <!-- Phase 14: cold-start backup handler (BCL only) -->
    <Compile Include="Adapters/QualityCheck.fs" />        <!-- Phase 14: isBadResponse heuristic + QualityFallbackOptions (BCL only) -->
    <Compile Include="Adapters/DecisionLogger.fs" />
    <Compile Include="Adapters/DecisionLogWriter.fs" />
    <Compile Include="Adapters/TraceLogger.fs" />           <!-- Phase 14: trace JSONL writer (Channel + BackgroundService) -->
    <Compile Include="Adapters/CorrelationMiddleware.fs" />
    <Compile Include="Adapters/RoutingAlgorithm.fs" />
    <Compile Include="Adapters/MlNetClassifier.fs" />          <!-- NEW: schema types come first -->
    <Compile Include="Adapters/BgeM3Embedder.fs" />            <!-- NEW: depends on Core/MLPorts only -->
    <Compile Include="Adapters/ModelBootstrapper.fs" />        <!-- NEW: depends on MlNetClassifier (RouteInput) -->
    <Compile Include="Adapters/QwenUpstreamClient.fs" />
    <Compile Include="Adapters/QueueDispatcher.fs" />
    <!-- Phase 7 — Failure detection + teacher labeling -->
    <Compile Include="Adapters/FailureDetector.fs" />
    <Compile Include="Adapters/TeacherLabeler.fs" />
    <Compile Include="Adapters/HardCaseDatasetWriter.fs" />
    <!-- Phase 8 — Retraining loop foundation -->
    <Compile Include="Adapters/Retrainer.fs" />
    <Compile Include="Adapters/DatasetMerger.fs" />
    <Compile Include="Adapters/Validator.fs" />
    <Compile Include="Adapters/ModelVersionProvider.fs" />
    <!-- Phase 9 — Canary deployment (Task 1 — leaf adapters + Gate) -->
    <!-- RetrainLock placed before RetrainingService because RetrainingService now consumes IRetrainLock -->
    <Compile Include="Adapters/RetrainLock.fs" />
    <Compile Include="Adapters/RetrainingService.fs" />
    <Compile Include="Adapters/CanaryTargetingAccessor.fs" />
    <Compile Include="Adapters/CanaryState.fs" />
    <Compile Include="Adapters/CanaryMetrics.fs" />
    <Compile Include="Adapters/CanaryGate.fs" />
    <!-- Phase 9 — Canary deployment (Task 2 — watcher adapters) -->
    <Compile Include="Adapters/CanaryWatchdog.fs" />
    <Compile Include="Adapters/CanaryService.fs" />
    <!-- Phase 10 — Health probing -->
    <Compile Include="Adapters/HealthService.fs" />
    <!-- Phase 13 — Log retention background service -->
    <Compile Include="Adapters/LogRetentionService.fs" />
    <Compile Include="Endpoints/ChatCompletions.fs" />
    <Compile Include="Endpoints/Stats.fs" />
    <Compile Include="Endpoints/Canary.fs" />
    <Compile Include="Endpoints/Health.fs" />
    <Compile Include="Endpoints/Models.fs" />
    <Compile Include="CompositionRoot.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Include="FSharp.Control.TaskSeq" Version="1.1.1" />
    <!-- ML stack — Phase 6 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.25.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.ML" Version="5.0.0" />
    <!-- Feature flag stack — Phase 9 -->
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmartRouter.Core\SmartRouter.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
