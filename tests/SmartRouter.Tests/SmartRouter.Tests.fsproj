<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="StreamingTests.fs" />
    <Compile Include="QueueTests.fs" />
    <Compile Include="LoadTests.fs" />
    <Compile Include="MLRoutingTests.fs" />
    <Compile Include="MLEmbeddingTests.fs" />
    <Compile Include="MLClassifierTests.fs" />
    <Compile Include="LoggingTests.fs" />
    <!-- Phase 7 -->
    <Compile Include="FailureDetectorTests.fs" />
    <Compile Include="TeacherLabelerTests.fs" />
    <Compile Include="HardCaseDatasetTests.fs" />
    <!-- Phase 8 -->
    <Compile Include="RetrainingTests.fs" />
    <!-- Phase 9 -->
    <Compile Include="CanaryTests.fs" />
    <!-- Phase 10 -->
    <Compile Include="HealthFallbackTests.fs" />
    <!-- Phase 11 -->
    <Compile Include="ModelsTests.fs" />
    <!-- Phase 13 -->
    <Compile Include="LogRotationTests.fs" />
    <!-- Issue #8: production DI graph integration tests -->
    <Compile Include="ProductionDiTests.fs" />
    <!-- Issue #12: ML.makeApplyML reads IModelVersionProvider live (post-retrain) -->
    <Compile Include="MLLiveVersionTests.fs" />
    <!-- Phase 14: quality fallback integration tests -->
    <Compile Include="QualityFallbackTests.fs" />
    <!-- Phase 15: quality signal enrichment tests -->
    <Compile Include="QualitySignalEnrichmentTests.fs" />
    <!-- Phase 16: 122B-as-judge for borderline cases -->
    <Compile Include="JudgeIntegrationTests.fs" />
    <!-- Phase 17: Hard Rules layer + Routing.Mode switch -->
    <Compile Include="HardRulesTests.fs" />
    <Compile Include="ModeSwitchTests.fs" />
    <!-- Phase 18: Session Store + Sticky Escalation -->
    <Compile Include="SessionStoreTests.fs" />
    <Compile Include="StickyEscalationTests.fs" />
    <!-- Phase 19: 35B Self-Routing tests -->
    <Compile Include="SelfRouterTests.fs" />
    <Compile Include="SelfRoutingIntegrationTests.fs" />
    <Compile Include="MlDormantTests.fs" />
    <Compile Include="RouterTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\SmartRouter.Cli\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="10.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <!-- FrameworkReference provides Kestrel/WebApplication APIs for in-process test hosting -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartRouter.Core\SmartRouter.Core.fsproj" />
    <ProjectReference Include="..\..\src\SmartRouter.Cli\SmartRouter.Cli.fsproj" />
  </ItemGroup>
</Project>
